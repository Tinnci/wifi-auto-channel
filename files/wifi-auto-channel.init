#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	local enabled
	config_load wifi-auto-channel
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/wifi-auto-channel
	procd_set_param file /etc/config/wifi-auto-channel
	procd_set_param respawn 3600 15 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "wifi-auto-channel"
}
